# Estimations app — environment template. Copy to .env and fill in.
# Never commit the real .env file.

PORT=3001
DB_PATH=./data/estimates.sqlite

# JIRA_MODE / CONFLUENCE_MODE: 'mock' (default, no network/credentials needed) or 'live'
JIRA_MODE=mock
CONFLUENCE_MODE=mock

ATLASSIAN_SITE_NAME=
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=

# Required only when CONFLUENCE_MODE=live
CONFLUENCE_ESTIMATES_SPACE_KEY=
CONFLUENCE_ESTIMATES_PARENT_PAGE_ID=

# Shared secret checked against the X-Webhook-Secret header on inbound Jira webhooks.
JIRA_WEBHOOK_SHARED_SECRET=

# ── Optional LLM deep-dive path ────────────────────────────────────────────
# LLM_MODE: 'none' (default, fully deterministic) or 'enabled'
# When enabled, escalated stories receive an additional Anthropic PERT estimate
# blended with the deterministic result (LLM × 0.4 + deterministic × 0.6).
# Per-request: pass withLlm=true in the POST body to activate on that call.
LLM_MODE=none
LLM_PROVIDER=claude-cli   # or anthropic-api (needs ANTHROPIC_API_KEY credit)
# Never commit a real API key — use Azure Key Vault / env injection in prod.
ANTHROPIC_API_KEY=

# Organisation name used in the LLM system prompt
ORG_NAME=
