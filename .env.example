# Estimations app — environment template. Copy to .env and fill in.
# Never commit the real .env file.

PORT=3001
DB_PATH=./data/estimates.sqlite

# JIRA_MODE / CONFLUENCE_MODE: 'mock' (default, no network/credentials needed) or 'live'
JIRA_MODE=mock
CONFLUENCE_MODE=mock

ATLASSIAN_SITE_NAME=
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=

# Required only when CONFLUENCE_MODE=live
CONFLUENCE_ESTIMATES_SPACE_KEY=
CONFLUENCE_ESTIMATES_PARENT_PAGE_ID=

# Shared secret checked against the X-Webhook-Secret header on inbound Jira webhooks.
JIRA_WEBHOOK_SHARED_SECRET=

# ── Optional LLM deep-dive path ────────────────────────────────────────────
# LLM_MODE: 'none' (default, fully deterministic) or 'enabled'
# When enabled, escalated stories receive an additional Anthropic PERT estimate
# blended with the deterministic result (LLM × 0.4 + deterministic × 0.6).
# Per-request: pass withLlm=true in the POST body to activate on that call.
LLM_MODE=none
LLM_PROVIDER=claude-cli   # or anthropic-api (needs ANTHROPIC_API_KEY credit)
# Never commit a real API key — use Azure Key Vault / env injection in prod.
ANTHROPIC_API_KEY=

# Organisation name used in the LLM system prompt
ORG_NAME=

# ── Optional settings (leave commented to keep the code defaults) ──
# CLAUDE_CLI_BIN=              path to the CLI used when LLM_PROVIDER is claude-cli (default: claude)
# LLM_MODEL=                   model name for the LLM deep-dive
# CONFIG_LOCAL_DIR=            folder with private config files that replace the committed samples (default: ./config.local)

# ── Formula pipeline (leave blank to keep the app on the legacy engine) ──
# ESTIMATION_MODE: legacy (default) or formula; a request can override it with "mode".
ESTIMATION_MODE=
# SCOPE_HOME: the installed scope engine folder. Setting it switches the pipeline on; SCOPE_BOUNDED (the memory-cap wrapper) is then required.
SCOPE_HOME=
SCOPE_BOUNDED=
# SCOPE_BOUNDED_MB=            memory cap per scope run in MB (default 1024)
SCOPE_TIMEOUT_MS=
SCOPE_WORK_DIR=
# OUTPUTS_ENABLED: must be exactly "true" before any real write; publishing is a dry run otherwise.
OUTPUTS_ENABLED=
MAX_BATCH_SIZE=
MAX_NOTES_CHARS=
